<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo1.mapper.PlantMapper">

    <resultMap id="PlantResultMap" type="org.example.demo1.Plant">
        <id property="pid" column="pid"/>
        <result property="pname" column="pname"/>
        <result property="ptype" column="ptype"/>
        <result property="pdatetime" column="pdatetime"/>
        <result property="pprice" column="pprice"/>
        <result property="ppic" column="ppic"/>
        <result property="pdesc" column="pdesc"/>
        <result property="areaId" column="area_id"/>
        <result property="latitude" column="latitude"/>
        <result property="longitude" column="longitude"/>
        <result property="trimPeriodDays" column="trim_period_days"/>
        <result property="fertilizePeriodDays" column="fertilize_period_days"/>
        <result property="waterPeriodDays" column="water_period_days"/>
        <result property="pestPeriodDays" column="pest_period_days"/>
        <result property="nextTrimDate" column="next_trim_date"/>
        <result property="nextFertilizeDate" column="next_fertilize_date"/>
        <result property="nextWaterDate" column="next_water_date"/>
        <result property="nextPestDate" column="next_pest_date"/>
    </resultMap>

    <sql id="PlantColumns">
        pid, pname, ptype, pdatetime, pprice, ppic, pdesc, area_id, latitude, longitude,
        trim_period_days, fertilize_period_days, water_period_days, pest_period_days,
        next_trim_date, next_fertilize_date, next_water_date, next_pest_date
    </sql>

    <select id="selectPlantById" resultMap="PlantResultMap">
        SELECT <include refid="PlantColumns"/>
        FROM plant
        WHERE pid = #{pid}
    </select>

    <update id="updatePlantCareDate">
        UPDATE plant
        <set>
            <choose>
                <when test="dateCol == 'next_water_date'">next_water_date = #{nextDate}</when>
                <when test="dateCol == 'next_fertilize_date'">next_fertilize_date = #{nextDate}</when>
                <when test="dateCol == 'next_trim_date'">next_trim_date = #{nextDate}</when>
                <when test="dateCol == 'next_pest_date'">next_pest_date = #{nextDate}</when>
            </choose>
        </set>
        WHERE pid = #{pid}
    </update>

</mapper>
