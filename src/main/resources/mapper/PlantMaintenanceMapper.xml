<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo1.mapper.PlantMaintenanceMapper">

    <resultMap id="PlantMaintenanceResultMap" type="org.example.demo1.PlantMaintenance">
        <id property="mid" column="mid"/>
        <result property="pid" column="pid"/>
        <result property="pname" column="pname"/>
        <result property="mtype" column="mtype"/>
        <result property="mdate" column="mdate"/>
        <result property="operator" column="operator"/>
        <result property="healthStatus" column="health_status"/>
        <result property="notes" column="notes"/>
    </resultMap>

    <insert id="insertMaintenance" parameterType="org.example.demo1.PlantMaintenance" useGeneratedKeys="true" keyProperty="mid">
        INSERT INTO plant_maintenance (pid, pname, mtype, mdate, operator, health_status, notes)
        VALUES (#{pid}, #{pname}, #{mtype}, #{mdate}, #{operator}, #{healthStatus}, #{notes})
    </insert>

</mapper>
