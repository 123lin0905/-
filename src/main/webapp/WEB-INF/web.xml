<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <!-- 系统只保留三维生态这一套页面。网站打开后先出现身份识别窗口 face_login.jsp：
         人脸识别成功，或在同一窗口切到“账号密码登录”登录成功 → 管理员进数据大屏 data_screen.jsp，养护人员进养护工作台 care_workbench.jsp；
         “先不录入人脸 / 以访客进入” → 3D 虚拟生态主页 ecohome.jsp（只读）。
         已登录 / 已选访客身份的会话再访问根路径时，face_login.jsp 直接跳到各自主页。 -->
    <welcome-file-list>
        <welcome-file>face_login.jsp</welcome-file>
    </welcome-file-list>
</web-app>